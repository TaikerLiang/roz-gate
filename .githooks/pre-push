#!/bin/sh
# The release gate, on every push: the hook unit tests, the eval ledger's
# lint tier, the ledger page's freshness and the replay checkers' red-proofs
# must be green (the first three are sub-second, the red-proofs seconds —
# they seed real sandboxes, no model; --no-verify is the human override, CI
# the backstop). The version is not this gate's business any more: it moves
# only in the release PR (docs/releasing.md), and a feature PR carries a
# `## Release note` section in its body instead — CI's release-note job
# checks that (issue #131: a bump in every feature PR was the conflict in
# every feature PR).

# Hook-time git exports GIT_DIR; the suites below create sandbox repos
# whose git calls must never act on THIS repo (a push from a linked
# worktree false-fails 4 hook tests otherwise).
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE

for suite in "python3 hooks/tests/run_tests.py" "python3 evals/lint/run_lint.py" \
             "python3 tools/ledger.py --check" "python3 evals/replay/run_redproofs.py"; do
  out=$($suite 2>&1) || {
    echo "pre-push: $suite failed:" >&2
    echo "$out" | grep -v '^PASS ' >&2
    echo "Fix it (or push with --no-verify to override)." >&2
    exit 1
  }
done

exit 0
