# Copy to .env (gitignored). Localhost-only values for a dev machine — every
# service but the web UI is unpublished (see docker-compose.override.yml).
# `docker compose` reads this file for interpolation; `set -a; . ./.env; set +a`
# hands the LANGFUSE_* trio to evals/replay/export_langfuse.py.

# --- secrets the compose marks CHANGEME (dev-only; rotate if ever exposed) ---
SALT=roz-gate-local-salt
ENCRYPTION_KEY=5f3c0a9b1e7d4c2a8b6f0e1d3c5a7b9d2e4f6a8c0b1d3e5f7a9c1b3d5e7f9a0b
NEXTAUTH_SECRET=roz-gate-local-nextauth-secret
NEXTAUTH_URL=http://localhost:3000
POSTGRES_USER=postgres
POSTGRES_PASSWORD=roz-gate-local-postgres
POSTGRES_DB=postgres
DATABASE_URL=postgresql://postgres:roz-gate-local-postgres@postgres:5432/postgres
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=roz-gate-local-clickhouse
REDIS_AUTH=roz-gate-local-redis
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=roz-gate-local-minio
LANGFUSE_S3_EVENT_UPLOAD_ACCESS_KEY_ID=minio
LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY=roz-gate-local-minio
LANGFUSE_S3_MEDIA_UPLOAD_ACCESS_KEY_ID=minio
LANGFUSE_S3_MEDIA_UPLOAD_SECRET_ACCESS_KEY=roz-gate-local-minio
LANGFUSE_S3_BATCH_EXPORT_ACCESS_KEY_ID=minio
LANGFUSE_S3_BATCH_EXPORT_SECRET_ACCESS_KEY=roz-gate-local-minio
TELEMETRY_ENABLED=false

# --- first boot: the org, the project and its API keys, the login ---------
LANGFUSE_INIT_ORG_ID=roz-gate
LANGFUSE_INIT_ORG_NAME=roz-gate
LANGFUSE_INIT_PROJECT_ID=roz-gate
LANGFUSE_INIT_PROJECT_NAME=roz-gate
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-roz-gate-local-00000000-0000-0000-0000-000000000001
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-roz-gate-local-00000000-0000-0000-0000-000000000001
LANGFUSE_INIT_USER_EMAIL=paul@roz-gate.local
LANGFUSE_INIT_USER_NAME=paul
LANGFUSE_INIT_USER_PASSWORD=roz-gate-local-login

# --- the exporter (evals/replay/export_langfuse.py, run_replay.py) ----------
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=pk-lf-roz-gate-local-00000000-0000-0000-0000-000000000001
LANGFUSE_SECRET_KEY=sk-lf-roz-gate-local-00000000-0000-0000-0000-000000000001
LANGFUSE_PROJECT_ID=roz-gate   # only completes the trace link the exporter prints
