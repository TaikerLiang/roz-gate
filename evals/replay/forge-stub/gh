#!/usr/bin/env python3
"""Stateful GitHub forge stub for the replay tier.

Shadows the real `gh` via PATH inside a replay sandbox. State lives in
$FORGE_STATE/state.json (seeded from the case fixture); every invocation
appends one line to $FORGE_STATE/journal.jsonl — the journal is the
tier's primary observation channel, each entry stamped `ts` (epoch
seconds) so a write can be placed under the tool call that made it
(#190). Writes mutate state so a command that reads back its own write
mid-run sees it (canned responses would desynchronize by step two).

Routes cover exactly the operations references/forge-github.md names,
plus a small class of benign read-only probes (PROBES below). An
invocation matching no route exits 64 and journals route=UNKNOWN —
the runner fails the whole case on any UNKNOWN (a reach the fixture
does not define is the same disease as a silent network reach). Nothing
here touches the network, ever.
"""

import atexit
import json
import os
import re
import shutil
import subprocess
import sys
import time
from urllib.parse import unquote

STATE_DIR = os.environ.get("FORGE_STATE")
if not STATE_DIR:
    sys.stderr.write("forge-stub: FORGE_STATE not set\n")
    sys.exit(64)
STATE = os.path.join(STATE_DIR, "state.json")
JOURNAL = os.path.join(STATE_DIR, "journal.jsonl")


def load():
    with open(STATE, encoding="utf-8") as f:
        return json.load(f)


def save(st):
    with open(STATE, "w", encoding="utf-8") as f:
        json.dump(st, f, indent=1)


# Where the last body came from, when not inline: "file" | "stdin" |
# "input-file". Set by read_body_file / api_fields, attached to the next
# journal entry as body_from — diagnostics only; the body field itself
# always carries the CONTENT (rule C's --body-file hole, stub instance:
# a journal that records `@/tmp/x.md` or "" where the forge received a
# marker-prefixed reply blinds every checker downstream).
BODY_ORIGIN = {"origin": None}


# This invocation's journal entries, appended to the file in one write
# when the process ends (atexit; `unknown()` and `main()` flush first).
# The journal is append-only — seats run concurrently and two stub
# invocations overlap, so a read/truncate/rewrite could drop another
# invocation's entry (codex review, PR #223: an UNKNOWN vanished). A
# field learned after the route journaled (`jq: system`, #219) is set on
# the pending entry in memory, never on the file.
PENDING = []


def journal(route, write=False, **kw):
    entry = {"route": route, "write": write, "argv": sys.argv[1:], "ts": time.time()}
    if BODY_ORIGIN["origin"]:
        entry["body_from"] = BODY_ORIGIN["origin"]
    entry.update(kw)
    PENDING.append(entry)


def flush_journal():
    if not PENDING:
        return
    with open(JOURNAL, "a", encoding="utf-8") as f:
        f.write("".join(json.dumps(e, ensure_ascii=False) + "\n" for e in PENDING))
    PENDING.clear()


atexit.register(flush_journal)


def annotate_last(**kw):
    """Add fields to this invocation's last journal entry — the route
    handler journals before it projects, and the projection is what learns
    which evaluator answered the --jq (#219). In memory: the file is
    append-only."""
    if PENDING:
        PENDING[-1].update(kw)


def read_body_file(path, origin="file"):
    """Contents behind gh's file conventions; `-` reads stdin. A missing
    file is journaled as its own condition and errors like the real CLI —
    never silently an empty body."""
    if path == "-":
        BODY_ORIGIN["origin"] = "stdin"
        return sys.stdin.read()
    try:
        with open(path, encoding="utf-8") as f:
            BODY_ORIGIN["origin"] = origin
            return f.read()
    except OSError:
        journal("body-file-missing", path=path)
        sys.stderr.write("forge-stub: could not read body file: %s\n" % path)
        sys.exit(1)


def body_arg(argv):
    """Body of an issue/pr command: --body/-b inline, or --body-file/-F
    <path> (gh reads the file; `-` = stdin). None when neither is given."""
    path = flag_val(argv, "--body-file", "-F")
    if path is not None:
        return read_body_file(path)
    return flag_val(argv, "--body", "-b")


def expand_shas(text):
    """`{{sha:<ref>}}` in a fixture's comment body → the sandbox's SHA for
    that ref (`origin/<ref>` first, then `<ref>`), at read time. A fixture
    cannot know a seeded commit's SHA (seed.sh makes it at run time), and
    the code-review record's `reviewed-sha:` must equal the CR's head
    (#140, 2.0.0): the stub resolves it the way `pulls/<n>`'s `head.sha`
    is resolved. An unresolvable ref is left as written — a visible
    fixture defect, never a silently empty field."""
    def sub(m):
        ref = m.group(1)
        for cand in ("origin/%s" % ref, ref):
            try:
                rp = subprocess.run(["git", "rev-parse", "--verify", "-q", cand + "^{commit}"],
                                    capture_output=True, text=True, timeout=10)
            except (OSError, subprocess.TimeoutExpired):
                rp = None
            if rp is not None and rp.returncode == 0:
                return rp.stdout.strip()
        return m.group(0)
    return re.sub(r"\{\{sha:([^}\s]+)\}\}", sub, text or "")


def out(obj):
    print(json.dumps(obj, ensure_ascii=False))


REPO_SEG = re.compile(r"^(?:[A-Za-z0-9_.-]+|\{owner\}|\{repo\}|:owner|:repo)$")


def http_error(status, text, **kw):
    """gh's own answer to a request GitHub refuses — not UNKNOWN: what gh
    does here is known, and the seat's recovery from its own bad call is
    the behaviour under measurement (#237: Haiku's seats pasted a JSON
    fragment into the path 13 times in 44 iterations)."""
    journal("http-%d" % status, **kw)
    flush_journal()
    sys.stderr.write("gh: %s (HTTP %d)\n" % (text, status))
    sys.exit(1)


def gql_not_found(kind, number, path):
    """gh's answer to a number GitHub cannot resolve — not UNKNOWN: the
    seat used an issue number as a PR number (2 iterations, haiku55 sweep
    2026-11-12) and recovers from gh's message."""
    journal("graphql-error", kind=kind, number=str(number)[:20])
    flush_journal()
    sys.stderr.write("GraphQL: Could not resolve to a %s with the number of %s. (%s)\n"
                     % (kind, number, path))
    sys.exit(1)


def unknown(why):
    journal("UNKNOWN", note=why)
    flush_journal()
    sys.stderr.write("forge-stub: no route for: gh %s (%s)\n"
                     % (" ".join(sys.argv[1:]), why))
    sys.exit(64)


def flag_val(argv, *names):
    for i, a in enumerate(argv):
        for n in names:
            if a == n and i + 1 < len(argv):
                return argv[i + 1]
            if a.startswith(n + "="):
                return a.split("=", 1)[1]
    return None


def flag_vals(argv, *names):
    vals = []
    for i, a in enumerate(argv):
        for n in names:
            if a == n and i + 1 < len(argv):
                vals.append(argv[i + 1])
            elif a.startswith(n + "="):
                vals.append(a.split("=", 1)[1])
    return vals


def api_fields(argv):
    """-f/-F key=value pairs of a gh api call, plus --input.

    -F/--field resolves gh's @file / @- convention (the value is the
    file's contents); -f/--raw-field stays LITERAL, as in the real CLI —
    resolving a raw field would journal content the real forge never
    received, and the instrument must not lie in either direction.
    --input <file|-> is a JSON request body; its keys merge in under any
    explicit fields."""
    fields = {}
    inp = flag_val(argv, "--input")
    if inp is not None:
        try:
            parsed = json.loads(read_body_file(inp, origin="input-file"))
            if isinstance(parsed, dict):
                fields.update(parsed)
        except ValueError:
            journal("input-file-unparseable", path=inp)
            sys.stderr.write("forge-stub: --input is not JSON: %s\n" % inp)
            sys.exit(1)
    for i, a in enumerate(argv):
        if a in ("-f", "-F", "--field", "--raw-field") and i + 1 < len(argv):
            kv = argv[i + 1]
            if "=" in kv:
                k, v = kv.split("=", 1)
                if a in ("-F", "--field") and v.startswith("@"):
                    v = read_body_file(v[1:])
                fields[k] = v
    return fields


def gql_login(c):
    """gh's --json (GraphQL) login: a bot's `[bot]` suffix is dropped and no
    type travels with it — `github-actions`, as live gh prints it (#174)."""
    login = c.get("author", "")
    if c.get("author_type") == "Bot" and login.endswith("[bot]"):
        return login[:-5]
    return login


def repo_slug(st):
    """#250 — `<owner>/<repo>`: the fixture's own repository, the one `gh
    repo view` names and the sandbox's remote points at."""
    repo = st.get("repo") or {}
    return "%s/%s" % (repo.get("owner", "acme"), repo.get("name", "demo"))


def web(st):
    """The repository's web root — every URL the stub prints or returns
    starts here, so none can name a repository the fixture is not."""
    return "https://github.com/" + repo_slug(st)


# #250 — the `--json` fields each command SERVES: the ones the fixture can
# answer faithfully, and nothing else. Not gh's field catalog — a field
# that is not here (gh's or a typo) is UNKNOWN, never a silent blank. Each
# value is computed only when asked for.
ISSUE_FIELDS = {
    "number": lambda st, n, iss: int(n),
    "url": lambda st, n, iss: web(st) + "/issues/%s" % n,
    "title": lambda st, n, iss: iss.get("title", ""),
    "body": lambda st, n, iss: iss.get("body", ""),
    "state": lambda st, n, iss: iss.get("state", "open").upper(),
    "closed": lambda st, n, iss: iss.get("state", "open").lower() != "open",
    "labels": lambda st, n, iss: [{"name": l} for l in iss.get("labels", [])],
    "assignees": lambda st, n, iss: [{"login": a} for a in iss.get("assignees", [])],
    "author": lambda st, n, iss: {"login": iss.get("author", "")},
    "createdAt": lambda st, n, iss: iss.get("createdAt", "2026-08-01T00:00:00Z"),
    # #291 — stated by the fixture or not served. `updatedAt` is never the
    # latest of the timestamps the fixture happens to carry: that is a
    # lower bound, not GitHub's value.
    "updatedAt": lambda st, n, iss: iss["updatedAt"] if iss.get("updatedAt") else unserved(
        "updatedAt", "issue %s's fixture states none" % n),
    # gh's struct zero values for an open issue (api/queries_issue.go:
    # `StateReason string`, `ClosedAt *time.Time`); a closed one needs the fact
    "stateReason": lambda st, n, iss: _closed_fact(n, iss, "stateReason", ""),
    "closedAt": lambda st, n, iss: _closed_fact(n, iss, "closedAt", None),
    "comments": lambda st, n, iss: [
        {"id": c.get("id"), "author": {"login": gql_login(c)},
         "body": c.get("body", ""), "createdAt": c.get("createdAt", "")}
        for c in iss.get("comments", [])],
}

def _closed_fact(n, iss, key, when_open):
    if iss.get("state", "open").lower() == "open":
        return when_open
    if iss.get(key):
        return iss[key]
    return unserved(key, "issue %s is closed and its fixture states no %s" % (n, key))


def _default_branch(st):
    """The repository's default branch: the fixture's `repo.default_branch`,
    else the branch the remote's HEAD names — if that branch exists."""
    stated = (st.get("repo") or {}).get("default_branch")
    if stated:
        return {"name": stated}
    try:
        ls = subprocess.run(["git", "ls-remote", "--symref", "origin", "HEAD"],
                            capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.TimeoutExpired):
        ls = None
    m = re.search(r"^ref: refs/heads/(\S+)\s+HEAD$", ls.stdout, re.M) \
        if ls and ls.returncode == 0 else None
    if not m:
        return unserved("defaultBranchRef", "the fixture states no repo.default_branch and "
                        "the remote's HEAD names no branch")
    return {"name": m.group(1)}


REPO_FIELDS = {
    "owner": lambda st: {"login": repo_slug(st).split("/")[0]},
    "name": lambda st: repo_slug(st).split("/")[1],
    "nameWithOwner": lambda st: repo_slug(st),
    "url": lambda st: web(st),
    "defaultBranchRef": _default_branch,
}


def json_want(cmd, argv, served):
    """The `--json` fields asked for, validated as a whole BEFORE the route
    journals or prints anything: one unserved field makes the command
    UNKNOWN — never JSON with the served fields and the other dropped.
    No `--json` at all is [] — the empty projection the stub has always
    printed there (gh's human-readable view is not emulated)."""
    raw = flag_val(argv, "--json")
    if raw is None:
        return []
    want = [f.strip() for f in raw.split(",")]
    rejected = [f for f in want if f in GH_REJECTS.get(cmd, ())]
    if rejected:
        # gh's own client-side answer, before any request: the seat's
        # recovery is behaviour under measurement, so this is scored
        journal("json-field-rejected", field=rejected[0])
        flush_journal()
        sys.stderr.write('Unknown JSON field: "%s"\nAvailable fields:\n%s\n'
                         % (rejected[0], "\n".join("  " + f for f in sorted(served))))
        sys.exit(1)
    missing = [f for f in want if f not in served]
    if missing:
        unknown("%s --json %s: not served by the stub" % (cmd, ",".join(missing)))
    return want


# #291 — `--json` fields gh itself rejects for a command. NOT a catalog of
# gh's fields (#250): a name is added here only after a seat asked for it in
# a sweep AND real gh was seen to answer `Unknown JSON field` for it.
#   reviewThreads — haiku55 sweep 2026-11-12; `gh pr view --json reviewThreads`
#   on gh 2.89.0. gh prints its whole field list after the first line; the
#   stub prints the fields it serves, which is what is available here.
GH_REJECTS = {"pr view": {"reviewThreads"}, "pr list": {"reviewThreads"}}


def unserved(field, why):
    """A served field this fixture cannot answer for THIS issue or PR: the
    whole call is UNKNOWN and names the field — never a default in its
    place, and nothing of the call is journalled or printed (#250, #291)."""
    PENDING.clear()
    unknown("--json %s: %s" % (field, why))


def project(fields, want, *args):
    return {k: f(*args) for k, f in fields.items() if want is None or k in want}


def issue_shape(st, n, iss, want):
    return project(ISSUE_FIELDS, want, st, n, iss)


# Real gh accepts a head branch name (or nothing — the current branch)
# wherever it accepts a PR number; the live sweep's biggest invalid class
# (C5 5/5, 29 iterations total) was branch-name lookups the stub refused.
# Value-taking flags of the pr view / pr diff family — the VALUE is never
# the selector. `pr diff --color never spec/5` took `never` as the PR
# before --color was listed (codex review, PR #5); -e/--exclude is pr
# diff's other value flag (gh ≥ 2.68). pr view's are already covered.
PR_VALUE_FLAGS = {"--json", "-q", "--jq", "-t", "--template", "--repo", "-R",
                  "--color", "-e", "--exclude"}


def positional(argv, start):
    """First non-flag token, skipping value-taking flags."""
    i = start
    while i < len(argv):
        a = argv[i]
        if a in PR_VALUE_FLAGS:
            i += 2
            continue
        if a.startswith("-"):
            i += 1
            continue
        return a
    return None


def current_branch():
    try:
        r = subprocess.run(["git", "branch", "--show-current"],
                           capture_output=True, text=True)
        return r.stdout.strip() or None
    except OSError:
        return None


def pr_lookup(st, sel):
    """(number, pr) by PR number or head branch name; (None, None) if absent."""
    prs = st.get("prs", {})
    if sel in prs:
        return sel, prs[sel]
    for n, pr in prs.items():
        if pr.get("headRefName") == sel:
            return n, pr
    return None, None


def resolve_ref(ref):
    """`origin/<ref>` when the sandbox has it, else `<ref>` (expand_shas's
    order): a seed pushes every branch to the bare remote and may or may
    not keep a local one."""
    for cand in ("origin/%s" % ref, ref):
        try:
            rp = subprocess.run(["git", "rev-parse", "--verify", "-q", cand + "^{commit}"],
                                capture_output=True, text=True, timeout=10)
        except (OSError, subprocess.TimeoutExpired):
            return ref
        if rp.returncode == 0:
            return cand
    return ref


def pr_files(base, head):
    """`pulls/<n>/files` rows from `git diff base...head`: filename, status
    (GitHub's words), additions, deletions — the fields a seat reads. NUL
    records (`-z`), so a non-ASCII, tab or newline pathname is the real
    path, not git's quoted display form; a diff git cannot make (an
    unresolvable ref) raises — the route answers UNKNOWN, never an empty
    list (codex review, PR #223)."""
    status_word = {"A": "added", "M": "modified", "D": "removed", "R": "renamed",
                   "C": "copied", "T": "changed"}
    rng = "%s...%s" % (resolve_ref(base), resolve_ref(head))

    def records(kind):
        r = subprocess.run(["git", "diff", "-z", "-M", kind, rng], capture_output=True,
                           timeout=30)
        if r.returncode != 0:
            err = r.stderr.decode("utf-8", "replace").strip().splitlines() or ["git diff failed"]
            raise RuntimeError(err[0])
        toks = r.stdout.decode("utf-8", "surrogateescape").split("\0")
        return toks[:-1] if toks and toks[-1] == "" else toks

    counts = {}
    toks = records("--numstat")
    i = 0
    while i < len(toks):
        a, d, path = (toks[i].split("\t", 2) + ["", ""])[:3]
        i += 1
        if path == "" and i + 1 < len(toks):   # a rename: old, new follow as records
            path = toks[i + 1]
            i += 2
        counts[path] = (int(a) if a.isdigit() else 0, int(d) if d.isdigit() else 0)
    rows = []
    toks = records("--name-status")
    i = 0
    while i + 1 < len(toks):
        st, i = toks[i], i + 1
        prev = None
        if st[:1] in ("R", "C"):
            prev, name, i = toks[i], toks[i + 1], i + 2
        else:
            name, i = toks[i], i + 1
        a, d = counts.get(name, (0, 0))
        row = {"filename": name, "status": status_word.get(st[:1], "modified"),
               "additions": a, "deletions": d, "changes": a + d}
        if prev is not None:
            row["previous_filename"] = prev
        rows.append(row)
    return rows


def _head_oid(st, pr):
    # #133 — the head commit, resolved in the sandbox like `pulls/<n>`'s
    # `head.sha`; computed only when asked (one git call per row). An
    # unresolvable head is "" — a visible fixture defect, never invented.
    rp = subprocess.run(["git", "rev-parse", "--verify", "-q",
                         resolve_ref(pr.get("headRefName", "")) + "^{commit}"],
                        capture_output=True, text=True)
    # #272 — a head the forge deleted has no ref in the sandbox: the
    # fixture's own `headRefOid` answers for it, as the forge's record does
    return rp.stdout.strip() if rp.returncode == 0 else pr.get("headRefOid", "")


def _git(*args):
    try:
        p = subprocess.run(["git"] + list(args), capture_output=True, text=True, timeout=20)
    except (OSError, subprocess.TimeoutExpired):
        return None
    return p.stdout if p.returncode == 0 else None


def _pr_author(st, pr):
    """The fixture's `author`, which `pr create` also records for a PR made
    in this run. No fallback to the viewer: "the loop opens every CR here"
    is a convention of the corpus, not a fact about a PR that carries none
    (#291 review)."""
    if pr.get("author"):
        return {"login": gql_login(pr)}
    return unserved("author", "pr %s's fixture states no author" % pr.get("number"))


def _pr_reviews(st, pr):
    return [{"id": r.get("id"), "author": {"login": gql_login(r)},
             "body": expand_shas(r.get("body", "")), "state": r.get("state", ""),
             "submittedAt": r.get("submittedAt", r.get("submitted_at", ""))}
            for r in pr.get("reviews", [])]


def _review_decision(st, pr):
    """From the fixture's reviews and nothing else: each author's latest
    APPROVED / CHANGES_REQUESTED review, COMMENTED ignored. Any change
    request outstanding → CHANGES_REQUESTED; else any approval → APPROVED;
    else "" (gh's zero value). A state outside those three is not emulated."""
    latest = {}
    for r in pr.get("reviews", []):
        state = r.get("state", "")
        if state == "COMMENTED":
            continue
        if state not in ("APPROVED", "CHANGES_REQUESTED"):
            return unserved("reviewDecision", "pr %s has a %r review, which the stub does "
                            "not interpret" % (pr.get("number"), state))
        latest[r.get("author", "")] = state
    states = set(latest.values())
    return "CHANGES_REQUESTED" if "CHANGES_REQUESTED" in states else \
        "APPROVED" if states else ""


def _merge_commit(st, pr):
    """null while unmerged. Merged: the fixture's `mergeCommit`, else the
    ONE merge commit on the base that has the PR's head as a parent — the
    only history shape where the sandbox states what GitHub's
    `mergeCommit` is. A squash, a rebase, a head that moved, or two
    candidates are not guessed."""
    if pr.get("state", "OPEN").upper() != "MERGED":
        return None
    if pr.get("mergeCommit"):
        return {"oid": pr["mergeCommit"]}
    n = pr.get("number")
    head = _git("rev-parse", "--verify", "-q",
                resolve_ref(pr.get("headRefName", "")) + "^{commit}")
    log = _git("rev-list", "--merges", "--parents", resolve_ref(pr.get("baseRefName", "")))
    if not head or log is None:
        return unserved("mergeCommit", "pr %s is merged, its fixture states no mergeCommit "
                        "and its head or base does not resolve" % n)
    found = [line.split()[0] for line in log.splitlines() if head.strip() in line.split()[2:]]
    if len(found) != 1:
        return unserved("mergeCommit", "pr %s is merged, its fixture states no mergeCommit "
                        "and the base has %d merge commits with its head as a parent"
                        % (n, len(found)))
    return {"oid": found[0]}


CHANGE_TYPES = {"added": "ADDED", "modified": "MODIFIED", "removed": "DELETED",
                "renamed": "RENAMED", "copied": "COPIED", "changed": "CHANGED"}


def _pr_files(st, pr):
    """An OPEN PR's files are the sandbox's diff of head against base, in
    gh's shape (api/queries_pr.go PullRequestFile: path, additions,
    deletions, changeType) — the SAME rows `pulls/<n>/files` serves, read
    by the one parser (`pr_files`: NUL records, so a rename is its new
    path and a quoted pathname the real one). After a merge that diff is
    empty and GitHub's answer is not, so a merged PR's files are not served."""
    n = pr.get("number")
    if pr.get("state", "OPEN").upper() != "OPEN":
        return unserved("files", "pr %s is not open; the sandbox's diff is no longer its "
                        "file list" % n)
    try:
        rows = pr_files(pr.get("baseRefName", ""), pr.get("headRefName", ""))
    except (RuntimeError, OSError, subprocess.TimeoutExpired) as e:
        return unserved("files", "pr %s's base or head does not resolve in the sandbox (%s)"
                        % (n, str(e)[:80]))
    return [{"path": r["filename"], "additions": r["additions"], "deletions": r["deletions"],
             "changeType": CHANGE_TYPES.get(r["status"], "CHANGED")} for r in rows]


PR_FIELDS = {
    "number": lambda st, pr: pr.get("number"),
    "url": lambda st, pr: web(st) + "/pull/%s" % pr.get("number"),
    "title": lambda st, pr: pr.get("title", ""),
    "isDraft": lambda st, pr: pr.get("isDraft", False),
    "state": lambda st, pr: pr.get("state", "OPEN"),
    "closed": lambda st, pr: pr.get("state", "OPEN").upper() != "OPEN",
    "headRefName": lambda st, pr: pr.get("headRefName", ""),
    "baseRefName": lambda st, pr: pr.get("baseRefName", ""),
    "body": lambda st, pr: pr.get("body", ""),
    "labels": lambda st, pr: [{"name": l} for l in pr.get("labels", [])],
    "mergedAt": lambda st, pr: pr.get("mergedAt"),
    "headRefOid": _head_oid,
    # #291 — each from the fixture or the sandbox, or UNKNOWN naming itself
    # `{{sha:<ref>}}` expanded exactly as `issues/<n>/comments` expands it:
    # one comment is the same evidence by either route (a `reviewed-sha:`
    # left literal would read as a stale review)
    "comments": lambda st, pr: [
        {"id": c.get("id"), "author": {"login": gql_login(c)},
         "body": expand_shas(c.get("body", "")),
         "createdAt": c.get("createdAt", c.get("created_at", ""))}
        for c in pr.get("comments", [])],
    "reviews": _pr_reviews,
    "reviewDecision": _review_decision,
    "mergeCommit": _merge_commit,
    "files": _pr_files,
    "author": _pr_author,
}


def pr_shape(st, pr, want):
    return project(PR_FIELDS, want, st, pr)


def repo_labels(st):
    """The fixture repo's label set: the plugin's scheme (state may
    override via "labels")."""
    return st.get("labels") or [
        "track: spec", "track: fast", "status: ready-for-spec",
        "status: ready-for-dev", "status: in-spec-review",
        "status: in-user-review", "status: processing",
        "status: blocked"]


def api_method(argv):
    """gh's own rule: an explicit -X/--method wins; otherwise field
    parameters (-f/-F/--field/--raw-field/--input) make the request a
    POST, and only their absence makes it a GET. A stub that read
    `gh api repos/o/r/pulls -f state=closed` as a filtered GET list would
    launder a create-PR POST that fails on GitHub (codex review, PR #13)."""
    m = flag_val(argv, "-X", "--method")
    if m:
        return m.upper()
    for a in argv:
        if a in ("-f", "-F", "--field", "--raw-field", "--input") \
                or a.startswith(("--field=", "--raw-field=", "--input=")):
            return "POST"
    return "GET"


def _path(v, path):
    for seg in path.split("."):
        if seg == "":
            continue
        v = v.get(seg) if isinstance(v, dict) else None
    return v


def jq_eval(data, expr):
    """The jq subset the read routes must EVALUATE (real gh does; a
    projected value a SUT selects by must match GitHub's): stages joined
    by `|`, each one of `.`, `.[]`, `.[N]`, `.a.b`, `.[].a.b`, `.[N].a`,
    `length`, `{a, b: .c.d}` object construction, or a comma list of
    paths. Returns the list of output values; raises ValueError on
    anything else — the caller invalidates rather than printing the
    unprojected payload (silently wrong is the failure mode)."""
    stages, depth, cur = [], 0, ""
    for ch in expr:
        if ch in "{[(":
            depth += 1
        elif ch in "}])":
            depth -= 1
        if ch == "|" and depth == 0:
            stages.append(cur)
            cur = ""
        else:
            cur += ch
    stages.append(cur)
    values = [data]
    for st in (x.strip() for x in stages):
        new = []
        for v in values:
            if st == ".":
                new.append(v)
            elif st == "length":
                new.append(len(v) if isinstance(v, (list, dict, str)) else 0)
            elif st == ".[]":
                if not isinstance(v, list):
                    raise ValueError(st)
                new.extend(v)
            elif re.match(r"^\.\[\]\.[\w.]+$", st):
                if not isinstance(v, list):
                    raise ValueError(st)
                new.extend(_path(x, st[4:]) for x in v)
            elif re.match(r"^\.\[\d+\](\.[\w.]+)?$", st):
                i = int(st[2:st.index("]")])
                rest = st[st.index("]") + 1:]
                if not isinstance(v, list):
                    raise ValueError(st)
                x = v[i] if i < len(v) else None
                new.append(_path(x, rest) if rest else x)
            elif st.startswith("{") and st.endswith("}"):
                obj = {}
                for part in (q.strip() for q in st[1:-1].split(",") if q.strip()):
                    m = re.match(r"^(\w+)(?:\s*:\s*(\.[\w.]*))?$", part)
                    if not m:
                        raise ValueError(st)
                    obj[m.group(1)] = _path(v, m.group(2) or "." + m.group(1))
                new.append(obj)
            elif all(re.match(r"^\.[\w.]+$", q.strip()) for q in st.split(",")):
                new.extend(_path(v, q.strip()) for q in st.split(","))
            else:
                raise ValueError(st)
        values = new
    return values


def jq_project(data, expr):
    """Print `data` through `--jq expr` the way gh does (strings raw, else
    JSON, one output per line); no expression → the JSON itself. An
    expression outside the evaluated subset goes to the system `jq -rc`
    (the same output convention) when one is on PATH, and the journal's
    entry gains `jq: system`; a malformed expression, or no `jq`,
    invalidates the iteration (#219)."""
    if not expr:
        out(data)
        return
    try:
        vals = jq_eval(data, expr)
    except (ValueError, TypeError, AttributeError):
        if not shutil.which("jq"):
            unknown("jq expression not supported by the stub: %s" % expr)
        try:
            r = subprocess.run(["jq", "-rc", expr], input=json.dumps(data), capture_output=True,
                               text=True, timeout=30)
        except (OSError, subprocess.TimeoutExpired) as e:
            unknown("system jq failed: %s" % e)
        if r.returncode != 0:
            unknown("jq rejected the expression: %s"
                    % ((r.stderr.strip().splitlines() or ["?"])[0]))
        annotate_last(jq="system")
        sys.stdout.write(r.stdout)
        return
    for v in vals:
        print(v if isinstance(v, str) else json.dumps(v, ensure_ascii=False))


def next_id(st):
    st["_id"] = st.get("_id", 1000) + 1
    return st["_id"]


# Benign read-only probes — stateless, canned, journaled under a real
# route name. A cautious SUT pokes the CLI before trusting it (observed:
# opus ran `gh --version` at the smoke gate and was invalidated by the
# UNKNOWN policy while completing the task perfectly). Only this class is
# exempt; UNKNOWN stays exactly as-is for writes and semantic reads. The
# canned output is realistic rather than stub-branded: the probe exists
# because the SUT is sanity-checking its tools, and output that flags a
# simulation invites exactly the off-script investigation these routes
# absorb. Different SUTs probe differently — extend the list as
# transcripts show new probe shapes.
VERSION_TEXT = ("gh version 2.62.0 (2026-01-01)\n"
                "https://github.com/cli/cli/releases/tag/v2.62.0")
HELP_TEXT = """Work seamlessly with GitHub from the command line.

USAGE
  gh <command> <subcommand> [flags]

CORE COMMANDS
  api:         Make an authenticated GitHub API request
  auth:        Authenticate gh and git with GitHub
  issue:       Manage issues
  label:       Manage labels
  pr:          Manage pull requests
  repo:        Manage repositories

FLAGS
  --help      Show help for command
  --version   Show gh version"""

PROBES = (
    # (route, matcher, canned stdout, exit code)
    ("probe-version",
     lambda a: a[:1] in (["--version"], ["version"]), VERSION_TEXT, 0),
    ("probe-help",
     lambda a: "--help" in a or "-h" in a or a[:1] == ["help"], HELP_TEXT, 0),
    ("probe-help",  # bare `gh` — usage + exit 1, like the real CLI
     lambda a: not a, HELP_TEXT, 1),
)


def main():
    argv = sys.argv[1:]
    for route, match, text, rc in PROBES:
        if match(argv):
            journal(route)
            print(text)
            sys.exit(rc)
    st = load()

    # ---- gh repo view --json owner,name
    if argv[:2] == ["repo", "view"]:
        want = json_want("repo view", argv, REPO_FIELDS)
        journal("repo-view")
        # no --json: owner and name, as before #250
        out(project(REPO_FIELDS, want or ["owner", "name"], st))
        return

    # ---- gh auth status
    if argv[:2] == ["auth", "status"]:
        journal("auth-status")
        print("Logged in (forge-stub)")
        return

    # ---- issues
    if argv[:2] == ["issue", "list"]:
        state_q = (flag_val(argv, "--state") or "open").lower()
        want = json_want("issue list", argv, ISSUE_FIELDS)
        journal("issue-list", state=state_q)
        label = flag_val(argv, "--label")
        rows = []
        for n, iss in sorted(st.get("issues", {}).items(), key=lambda x: int(x[0])):
            if state_q != "all" and iss.get("state", "open") != state_q:
                continue
            if label and label not in iss.get("labels", []):
                continue
            rows.append(issue_shape(st, n, iss, want))
        out(rows)
        return

    if argv[:2] == ["issue", "view"]:
        n = argv[2]
        if n not in st.get("issues", {}):
            unknown("issue %s not in fixture" % n)
        want = json_want("issue view", argv, ISSUE_FIELDS)
        journal("issue-view", issue=n)
        out(issue_shape(st, n, st["issues"][n], want))
        return

    if argv[:2] == ["issue", "edit"]:
        n = argv[2]
        if n not in st.get("issues", {}):
            unknown("issue %s not in fixture" % n)
        iss = st["issues"][n]
        added = flag_vals(argv, "--add-label")
        removed = flag_vals(argv, "--remove-label")
        body = body_arg(argv)
        for l in added:
            if l not in iss.setdefault("labels", []):
                iss["labels"].append(l)
        for l in removed:
            if l in iss.get("labels", []):
                iss["labels"].remove(l)
        if body is not None:
            iss["body"] = body
        journal("issue-edit", write=True, issue=n, add=added, remove=removed,
                body_edit=body is not None)
        save(st)
        return

    # ---- gh issue close <n> — patrol's close-out (issue #41). A write; an
    # absent id stays UNKNOWN.
    if argv[:2] == ["issue", "close"]:
        n = argv[2] if len(argv) > 2 else ""
        if n not in st.get("issues", {}):
            unknown("issue %s not in fixture" % n)
        st["issues"][n]["state"] = "closed"
        journal("issue-close", write=True, issue=n)
        save(st)
        print("✓ Closed issue #%s" % n)
        return

    if argv[:2] == ["issue", "comment"]:
        n = argv[2]
        body = body_arg(argv) or ""
        cid = next_id(st)
        # GitHub semantics: every PR is an issue — `gh issue comment <pr>`
        # legally lands a top-level PR comment.
        if n in st.get("prs", {}):
            st["prs"][n].setdefault("comments", []).append(
                {"id": cid, "author": st.get("agent_login", "paul"),
                 "body": body, "created_at": "2026-08-24T12:00:00Z"})
            journal("pr-comment", write=True, pr=n, body=body, via="issue-comment")
        elif n in st.get("issues", {}):
            st["issues"][n].setdefault("comments", []).append(
                {"id": cid, "author": st.get("agent_login", "paul"),
                 "body": body, "createdAt": "2026-08-24T12:00:00Z"})
            journal("issue-comment", write=True, issue=n, body=body)
        else:
            unknown("issue %s not in fixture" % n)
        save(st)
        print(web(st) + "/issues/%s#issuecomment-%d" % (n, cid))
        return

    if argv[:2] == ["issue", "create"]:
        title = flag_val(argv, "--title") or ""
        body = body_arg(argv) or ""
        n = str(max([int(k) for k in st.get("issues", {})] + [0]) + 1)
        st.setdefault("issues", {})[n] = {
            "title": title, "body": body, "labels": flag_vals(argv, "--label"),
            "assignees": flag_vals(argv, "--assignee"),
            "author": st.get("agent_login", "paul"), "comments": []}
        journal("issue-create", write=True, issue=n, title=title)
        save(st)
        print(web(st) + "/issues/%s" % n)
        return

    # ---- pull requests
    if argv[:2] == ["pr", "list"]:
        want = json_want("pr list", argv, PR_FIELDS)
        journal("pr-list", state=flag_val(argv, "--state") or "open")
        head = flag_val(argv, "--head")
        state = (flag_val(argv, "--state") or "open").lower()
        rows = []
        for pr in st.get("prs", {}).values():
            if head and pr.get("headRefName") != head:
                continue
            pr_state = pr.get("state", "OPEN").lower()
            if state != "all" and pr_state != state:
                continue
            rows.append(pr_shape(st, pr, want))
        out(rows)
        return

    if argv[:2] == ["pr", "view"]:
        want = json_want("pr view", argv, PR_FIELDS)
        sel = positional(argv, 2)
        if sel is None:
            sel = current_branch()
        n, pr = pr_lookup(st, sel or "")
        if pr is None:
            if sel is not None and sel.isdigit():
                # #291 — a number with no pull request is gh's own error,
                # not a fixture gap: `GraphQL: <message> (<path>)` is
                # go-gh's format (pkg/api/errors.go), the message GitHub's
                gql_not_found("PullRequest", sel, "repository.pullRequest")
            # branch-name / current-branch miss: the real CLI answer is
            # "no PR", not a fixture gap — journal it, error like gh
            journal("pr-view-nomatch", selector=sel)
            sys.stderr.write("no pull requests found for branch %s\n" % sel)
            sys.exit(1)
        journal("pr-view", pr=n)
        out(pr_shape(st, pr, want))
        return

    # ---- gh pr diff <number|branch> — read-only; the sandbox repo has the
    # real branches, so the honest answer is git's own diff
    if argv[:2] == ["pr", "diff"]:
        sel = positional(argv, 2) or current_branch()
        n, pr = pr_lookup(st, sel or "")
        if pr is None:
            unknown("pr %s not in fixture" % sel)
        journal("pr-diff", pr=n)
        try:
            d = subprocess.run(
                ["git", "diff", "%s...%s" % (pr.get("baseRefName", ""),
                                             pr.get("headRefName", ""))],
                capture_output=True, text=True)
            sys.stdout.write(d.stdout)
        except OSError:
            pass
        return

    if argv[:2] == ["pr", "create"]:
        n = str(max([int(k) for k in st.get("prs", {})] + [100]) + 1)
        st.setdefault("prs", {})[n] = {
            "number": int(n), "title": flag_val(argv, "--title") or "",
            "body": body_arg(argv) or "",
            "state": "OPEN", "isDraft": "--draft" in argv,
            "headRefName": flag_val(argv, "--head") or "",
            "baseRefName": flag_val(argv, "--base") or "",
            "threads": [], "reviews": [], "comments": [],
            # recorded creation evidence (#291): who opened it, as the
            # stub already records for an issue or a comment it creates
            "author": st.get("agent_login", "paul")}
        journal("pr-create", write=True, pr=n,
                head=flag_val(argv, "--head"), draft="--draft" in argv)
        save(st)
        print(web(st) + "/pull/%s" % n)
        return

    if argv[:2] == ["pr", "ready"]:
        # #237: `--undo` converts back to draft; no selector means the
        # current branch's PR, as in gh.
        explicit = positional(argv, 2)
        sel = explicit or current_branch()
        n, _pr = pr_lookup(st, sel)
        if n is None and not (explicit and explicit.isdigit()):
            # gh reads a non-number selector as a branch name (pr view's rule)
            # gh's own answer when the checked-out branch has no PR
            journal("gh-error", branch=sel)
            flush_journal()
            sys.stderr.write('no pull requests found for branch "%s"\n' % sel)
            sys.exit(1)
        if n is None:
            unknown("pr %s not in fixture" % sel)
        undo = "--undo" in argv
        st["prs"][n]["isDraft"] = undo
        journal("pr-draft" if undo else "pr-ready", write=True, pr=n)
        save(st)
        return

    # ---- gh pr edit <n> --title/--body/--body-file — a write (#219: a QA
    # seat refreshed its CR body and the call was UNKNOWN). Not an op in
    # forge-github.md; the stub mirrors gh, the doc lists what the loop needs.
    if argv[:2] == ["pr", "edit"]:
        n, pr = pr_lookup(st, argv[2] if len(argv) > 2 else "")
        if n is None:
            unknown("pr %s not in fixture" % (argv[2] if len(argv) > 2 else ""))
        # A flag the stub does not perform (--base, --milestone,
        # --add-reviewer …) would journal a write that changed nothing: an
        # unsupported mutation stays UNKNOWN (codex review, PR #223).
        edits = ("--title", "-t", "--body", "-b", "--body-file", "-F",
                 "--add-label", "--remove-label")
        rest = argv[3:]
        i = 0
        while i < len(rest):
            a = rest[i]
            if a.startswith("-") and a != "-" and a.split("=", 1)[0] not in edits:
                unknown("pr edit flag not supported by the stub: %s" % a)
            i += 2 if a in edits else 1   # a flag's value is never a flag
        title = flag_val(argv, "--title", "-t")
        body = body_arg(argv)
        # gh splits a flag value on commas: --add-label "bug,help wanted"
        added = [x.strip() for v in flag_vals(argv, "--add-label") for x in v.split(",")]
        removed = [x.strip() for v in flag_vals(argv, "--remove-label") for x in v.split(",")]
        if title is None and body is None and not added and not removed:
            unknown("pr edit without --title, --body or a label")
        # haiku55 k=3 (#199): gh refuses a label the repository does not have
        # and edits nothing
        for l in added + removed:
            if l not in repo_labels(st):
                journal("gh-error", pr=n, label=l)
                flush_journal()
                sys.stderr.write("could not add label: '%s' not found\n" % l)
                sys.exit(1)
        if title is not None:
            pr["title"] = title
        if body is not None:
            pr["body"] = body
        labels = pr.setdefault("labels", [])
        labels[:] = [l for l in labels if l not in removed] + \
            [l for l in added if l not in labels]
        journal("pr-edit", write=True, pr=n, title_edit=title is not None,
                body_edit=body is not None, add=added, remove=removed)
        save(st)
        print(web(st) + "/pull/%s" % n)
        return

    if argv[:2] == ["pr", "comment"]:
        n, _pr = pr_lookup(st, argv[2])
        if n is None:
            unknown("pr %s not in fixture" % argv[2])
        body = body_arg(argv) or ""
        cid = next_id(st)
        st["prs"][n].setdefault("comments", []).append(
            {"id": cid, "author": st.get("agent_login", "paul"),
             "body": body, "created_at": "2026-08-24T12:00:00Z"})
        journal("pr-comment", write=True, pr=n, body=body)
        save(st)
        print(web(st) + "/pull/%s#issuecomment-%d" % (n, cid))
        return

    if argv[:2] == ["pr", "merge"]:
        n, _pr = pr_lookup(st, argv[2])
        if n is None:
            unknown("pr %s not in fixture" % argv[2])
        st["prs"][n]["state"] = "MERGED"
        journal("pr-merge", write=True, pr=n)
        save(st)
        return

    # ---- gh api
    if argv[:1] == ["api"]:
        # Options that consume a value: their VALUE is not a positional.
        # (`-X POST repos/...` must yield target repos/..., never POST.)
        VALUE_FLAGS = {"-X", "--method", "-f", "-F", "--field", "--raw-field",
                       "-H", "--header", "--jq", "-q", "--input", "-t",
                       "--template", "--hostname", "--cache", "-p", "--preview"}
        rest, i = [], 1
        while i < len(argv):
            a = argv[i]
            if a in VALUE_FLAGS:
                i += 2
                continue
            if a.startswith("-"):
                i += 1
                continue
            rest.append(a)
            i += 1
        target = rest[0] if rest else ""
        # A query string rides on the target (`pulls?state=all`); GET-mode
        # -f/-F fields are query parameters too. Split them off before
        # route matching — the judgment sweep's first UNKNOWN on a real
        # repo was exactly this shape.
        query = {}
        if "?" in target:
            target, qs = target.split("?", 1)
            for kv in qs.split("&"):
                if "=" in kv:
                    k, v = kv.split("=", 1)
                    query[k] = v
        method = api_method(argv)
        if method == "GET" and flag_val(argv, "-X", "--method"):
            query.update(api_fields(argv))   # explicit GET: fields are query params

        # #237 — a `repos/<owner>/<repo>/…` target whose owner or repo segment
        # is not a name (a pasted JSON fragment, an empty segment from `//`)
        # is one gh answers with 404. `{owner}`/`{repo}` and `:owner`/`:repo`
        # are gh's own placeholders and pass (every route below accepts them).
        if target.startswith("/repos/"):   # gh accepts the leading slash
            target = target[1:]
        if target.startswith("repos/"):
            mt = re.match(r"repos/([^/]*)/([^/]*)(?:/|$)", target)
            # Every later segment too: a pasted JSON fragment where the PR
            # number goes (`pulls/[{"number": 102}]/comments`), or an empty
            # segment (`pulls/comments/`) — gh gets 404 for both. A trailing
            # `contents/` is the repository root and stays valid.
            rest_segs = target.split("/")[3:]
            # A file path, a ref or a commit-ish is not an id: commas, quotes
            # and brackets are legal there (codex, PR #242) — the check stops
            # at contents/, git/ and commits/.
            for i, seg in enumerate(rest_segs):
                if seg in ("contents", "git", "commits"):
                    rest_segs = rest_segs[:i + 1]
                    break
            if not mt or "//" in target \
                    or not all(REPO_SEG.match(seg) for seg in mt.groups()) \
                    or any(not seg or (re.search(r'[{}\[\]"\',\s]', seg)
                                       and seg not in ("{owner}", "{repo}", "{branch}"))
                           for seg in rest_segs):
                http_error(404, "Not Found", target=target[:120])

        # ---- gh api user — the caller's own identity (the "who am I"
        # probe; judgment sweep F-67). The login is the fixture's
        # agent_login, so a SUT comparing it against comment authors sees
        # a consistent world.
        if target == "user" and method == "GET":
            journal("user-view")
            login_ = st.get("agent_login", "paul")
            jq_project({"login": login_, "id": 1, "type": "User",
                        "html_url": "https://github.com/%s" % login_},
                       flag_val(argv, "--jq", "-q"))
            return

        # ---- gh api repos/o/r/git/ref/heads/<branch> — does the branch
        # exist on the remote, and at which SHA (1.26.0's A2 check, asked
        # through the API instead of `git ls-remote`; F9 run-1 on the
        # v1.26.0 sweep). The forge's branches ARE the sandbox's bare
        # remote, so the answer comes from `git ls-remote origin` in the
        # caller's cwd; an absent branch is GitHub's 404, journaled under
        # the same route — a legitimate read of nothing, never UNKNOWN.
        m_ref = re.match(r"/?repos/[^/]+/[^/]+/git/refs?/heads/(.+)$", target)
        if m_ref and method == "GET":
            branch = unquote(m_ref.group(1))
            try:
                ls = subprocess.run(["git", "ls-remote", "--heads", "origin",
                                     "refs/heads/%s" % branch],
                                    capture_output=True, text=True, timeout=10)
                sha = ls.stdout.split()[0] if ls.returncode == 0 and ls.stdout.strip() else ""
            except (OSError, subprocess.TimeoutExpired):
                sha = ""
            journal("git-ref", branch=branch, present=bool(sha))
            if not sha:
                sys.stderr.write("gh: Not Found (HTTP 404)\n{\"message\":\"Not Found\"}\n")
                sys.exit(1)
            jq_project({"ref": "refs/heads/%s" % branch, "node_id": "REF_x",
                        "url": "https://api.github.com/repos/" + repo_slug(st) + "/git/refs/heads/%s" % branch,
                        "object": {"sha": sha, "type": "commit",
                                   "url": "https://api.github.com/repos/" + repo_slug(st) + "/git/commits/%s" % sha}},
                       flag_val(argv, "--jq", "-q"))
            return

        # ---- gh api repos/o/r/contents/<path>?ref=<branch> — a file or a
        # directory on a branch, read from the forge instead of a checkout
        # (F9 run-3 on the v1.26.0 sweep: review-answers listing the spec
        # dir on spec/5). Served from the sandbox's objects: `origin/<ref>`
        # when the tracking ref exists, else the local branch; absent path
        # or ref → GitHub's 404 under the same route. GET only.
        m_ct = re.match(r"/?repos/[^/]+/[^/]+/contents/(.*)$", target)
        if m_ct and method == "GET":
            path_ = unquote(m_ct.group(1)).strip("/")
            ref = query.get("ref") or "HEAD"
            def _git(*a):
                try:
                    r_ = subprocess.run(["git", *a], capture_output=True, text=True, timeout=10)
                except (OSError, subprocess.TimeoutExpired):
                    return None
                return r_.stdout if r_.returncode == 0 else None
            rev = None
            for cand in ("origin/%s" % ref, ref):
                if _git("rev-parse", "--verify", "-q", cand + "^{commit}"):
                    rev = cand
                    break
            listing = _git("ls-tree", rev, path_ if path_ else ".") if rev else None
            journal("contents", ref=ref, path=path_, present=bool(listing and listing.strip()))
            if not listing or not listing.strip():
                sys.stderr.write("gh: Not Found (HTTP 404)\n{\"message\":\"Not Found\"}\n")
                sys.exit(1)
            rows = [ln.split(None, 3) for ln in listing.splitlines() if ln.strip()]
            if len(rows) == 1 and rows[0][1] == "blob" and rows[0][3] == path_:
                import base64
                blob = _git("show", "%s:%s" % (rev, path_)) or ""
                view = {"name": path_.rsplit("/", 1)[-1], "path": path_, "type": "file",
                        "size": len(blob.encode("utf-8")), "encoding": "base64",
                        "content": base64.b64encode(blob.encode("utf-8")).decode("ascii")}
            else:
                dir_rows = _git("ls-tree", rev, path_ + "/" if path_ else ".") or ""
                view = [{"name": r4[3].rsplit("/", 1)[-1], "path": r4[3],
                         "type": "dir" if r4[1] == "tree" else "file"}
                        for r4 in (ln.split(None, 3) for ln in dir_rows.splitlines() if ln.strip())]
            jq_project(view, flag_val(argv, "--jq", "-q"))
            return

        # ---- gh api repos/o/r/pulls/<n> — one PR, REST shape (F9 run-5 on
        # the v1.26.0 sweep: `.head.sha` for the hand-back SHA). The twin of
        # `gh pr view --json`; head.sha resolves from the sandbox's objects.
        # An absent number is an absent id → UNKNOWN; non-GET stays UNKNOWN.
        m_pr = re.match(r"/?repos/[^/]+/[^/]+/pulls/(\d+)$", target)
        if m_pr and method == "GET":
            n_, pr_ = pr_lookup(st, m_pr.group(1))
            if n_ is None:
                unknown("pr %s not in fixture" % m_pr.group(1))
            journal("pr-view", pr=n_, via="api")
            head_ref = pr_.get("headRefName", "")
            sha = ""
            for cand in ("origin/%s" % head_ref, head_ref):
                try:
                    rp = subprocess.run(["git", "rev-parse", "--verify", "-q", cand + "^{commit}"],
                                        capture_output=True, text=True, timeout=10)
                except (OSError, subprocess.TimeoutExpired):
                    rp = None
                if rp is not None and rp.returncode == 0:
                    sha = rp.stdout.strip()
                    break
            pr_state = pr_.get("state", "OPEN").lower()
            jq_project({"number": int(n_), "title": pr_.get("title", ""), "body": pr_.get("body", ""),
                        "state": "open" if pr_state == "open" else "closed",
                        "draft": pr_.get("isDraft", False),
                        "merged_at": "2026-08-24T12:00:00Z" if pr_state == "merged" else None,
                        "html_url": web(st) + "/pull/%s" % n_,
                        "head": {"ref": head_ref, "sha": sha or "0" * 40},
                        "base": {"ref": pr_.get("baseRefName", "")},
                        "user": {"login": pr_.get("author", st.get("agent_login", "paul"))}},
                       flag_val(argv, "--jq", "-q"))
            return

        # ---- gh api repos/o/r/commits/<ref> — the commit a ref points at
        # (F9 run-5: `.sha` of spec/5). Resolved from the sandbox's objects;
        # an unknown ref is GitHub's 422/404 under the same route. GET only.
        m_cm = re.match(r"/?repos/[^/]+/[^/]+/commits/(.+)$", target)
        if m_cm and method == "GET":
            ref = unquote(m_cm.group(1))
            sha = ""
            for cand in ("origin/%s" % ref, ref):
                try:
                    rp = subprocess.run(["git", "rev-parse", "--verify", "-q", cand + "^{commit}"],
                                        capture_output=True, text=True, timeout=10)
                except (OSError, subprocess.TimeoutExpired):
                    rp = None
                if rp is not None and rp.returncode == 0:
                    sha = rp.stdout.strip()
                    break
            journal("commit-view", ref=ref, present=bool(sha))
            if not sha:
                sys.stderr.write("gh: No commit found for SHA: %s (HTTP 422)\n" % ref)
                sys.exit(1)
            msg = subprocess.run(["git", "log", "-1", "--format=%s", sha],
                                 capture_output=True, text=True).stdout.strip()
            jq_project({"sha": sha, "html_url": web(st) + "/commit/%s" % sha,
                        "commit": {"message": msg}}, flag_val(argv, "--jq", "-q"))
            return

        # ---- gh api /apps/<slug>, /users/<login> — the bot's identity by
        # name (judgment k=2 on 1.17.0: a bot-mode SUT whose token mint
        # failed went hunting for its App ID). Read-only, keyed on
        # agent_login exactly like `user`; `[bot]` (or %5Bbot%5D) is the
        # REST spelling of the same login. Any other slug or login is an
        # absent id and stays UNKNOWN.
        m_id = re.match(r"/?(apps|users)/([^/]+)$", target)
        if m_id and method == "GET":
            kind, name = m_id.group(1), unquote(m_id.group(2))
            login_ = st.get("agent_login", "paul")
            # `[bot]` is a login spelling, never an app slug: /apps/x[bot]
            # is an absent id (codex review, PR #35).
            bare = name[:-5] if kind == "users" and name.endswith("[bot]") else name
            if bare == login_:
                if kind == "apps":
                    journal("app-view", slug=name)
                    view = {"id": 100, "slug": name, "name": name,
                            "owner": {"login": login_},
                            "html_url": "https://github.com/apps/%s" % name}
                else:
                    journal("user-view", login=name)
                    view = {"login": name, "id": 2 if bare != name else 1,
                            "type": "Bot" if bare != name else "User",
                            "html_url": "https://github.com/%s" % name}
                jq_project(view, flag_val(argv, "--jq", "-q"))
                return

        # ---- gh api repos/o/r/pulls[?state=…&head=…] — REST PR list, the
        # `gh pr list` twin (D2 re-run on 1.16.2). Same filters, REST shape
        # (`state` lower-case, `head.ref`/`base.ref`, `draft`).
        if re.match(r"repos/[^/]+/[^/]+/pulls$", target) and method == "GET":
            state_q = (query.get("state") or "open").lower()
            head_q = query.get("head")
            if head_q and ":" in head_q:
                head_q = head_q.split(":", 1)[1]
            journal("pr-list", state=state_q, via="api")
            rows = []
            for pr in st.get("prs", {}).values():
                pr_state = pr.get("state", "OPEN").lower()
                rest_state = "open" if pr_state == "open" else "closed"
                if head_q and pr.get("headRefName") != head_q:
                    continue
                if state_q != "all" and rest_state != state_q:
                    continue
                rows.append({"number": pr.get("number"), "title": pr.get("title", ""),
                             "state": rest_state, "draft": pr.get("isDraft", False),
                             "merged_at": "2026-08-24T12:00:00Z" if pr_state == "merged" else None,
                             "head": {"ref": pr.get("headRefName", "")},
                             "base": {"ref": pr.get("baseRefName", "")},
                             "user": {"login": st.get("agent_login", "paul")},
                             "html_url": web(st) + "/pull/%s" % pr.get("number")})
            jq_project(rows, flag_val(argv, "--jq", "-q"))
            return

        if target == "graphql":
            q = flag_val(argv, "-f", "--field") or ""
            for i, a in enumerate(argv):  # -f query='...' arrives as one token
                if a in ("-f", "--field") and i + 1 < len(argv) \
                        and argv[i + 1].startswith("query="):
                    q = argv[i + 1].split("=", 1)[1]
            fields = api_fields(argv)
            # #237 — an owner that is not a name (a `{o}` placeholder left in,
            # a pasted JSON fragment) is gh's NOT_FOUND error, not UNKNOWN.
            mo = re.search(r'owner:\s*"([^"]*)"', q)
            if mo and not re.match(r"^[A-Za-z0-9_.-]+$", mo.group(1)):
                journal("graphql-error", owner=mo.group(1)[:40])
                flush_journal()
                sys.stderr.write("gh: Could not resolve to a Repository with the name "
                                 "'%s'. (NOT_FOUND)\n" % mo.group(1)[:40])
                sys.exit(1)
            # #237 — `repository(owner:…,name:…){ id }` alone: the node id.
            if re.search(r"repository\([^)]*\)\s*\{\s*id\s*\}", q):
                journal("graphql-repo-id")
                jq_project({"data": {"repository": {"id": "R_kgDOTqtK8g"}}},
                           flag_val(argv, "--jq", "-q"))
                return
            # haiku55 k=3: a PR's head SHA through graphql — the number as in
            # the threads route (a literal or the variable the query names).
            if "headRefOid" in q and "reviewThreads" not in q:
                m2 = re.search(r"pullRequest\(\s*number:\s*(?:\$(\w+)|(\d+))", q)
                pr = (fields.get(m2.group(1)) if m2 and m2.group(1)
                      else m2.group(2) if m2 else None)
                prd = st.get("prs", {}).get(str(pr))
                if not prd:
                    unknown("graphql headRefOid: pr %s not in fixture" % pr)
                rp = subprocess.run(["git", "rev-parse", "--verify", "-q",
                                     resolve_ref(prd.get("headRefName", "")) + "^{commit}"],
                                    capture_output=True, text=True)
                if rp.returncode != 0:
                    unknown("graphql headRefOid: head of pr %s unresolvable" % pr)
                journal("graphql-pr-head", pr=str(pr))
                jq_project({"data": {"repository": {"pullRequest":
                            {"headRefOid": rp.stdout.strip()}}}},
                           flag_val(argv, "--jq", "-q"))
                return
            if "reviewThreads" in q:
                # The number is whatever the query says it is: a literal, or
                # the variable it names — `$pr`, `$number`, `$p` (D12's seat,
                # #225) — read from the -F/-f fields under that name. A
                # variable no field supplies is UNKNOWN, as gh would error.
                # Each `[alias:]pullRequest(number:…)` field is answered under
                # its alias (haiku55 k=3: two PRs' threads in one query);
                # without an alias the key is `pullRequest`, as before.
                fields_q = re.findall(r"(?:(\w+)\s*:\s*)?pullRequest\(\s*number:\s*"
                                      r"(?:\$(\w+)|(\d+))", q)
                if not fields_q:
                    fields_q = [("", "", fields.get("pr") or fields.get("number"))]
                repo, prs_seen = {}, []
                for alias, var, lit in fields_q:
                    pr = fields.get(var) if var else lit
                    prd = st.get("prs", {}).get(str(pr))
                    if not prd:
                        unknown("graphql threads: pr %s not in fixture" % pr)
                    prs_seen.append(str(pr))
                    nodes = [{"id": t.get("id"), "isResolved": t.get("isResolved", False),
                              "path": t.get("path"), "line": t.get("line"),
                              "comments": {"nodes": [
                                  {"databaseId": c.get("databaseId"),
                                   "body": c.get("body", ""),
                                   "author": {"login": c.get("author", "")},
                                   "createdAt": c.get("createdAt", "")}
                                  for c in t.get("comments", [])]}}
                             for t in prd.get("threads", [])]
                    # one page holds every fixture thread (#133: a paginating
                    # reader asks for pageInfo and must be told there is no more)
                    repo[alias or "pullRequest"] = {"reviewThreads": {
                        "pageInfo": {"hasNextPage": False, "endCursor": None},
                        "nodes": nodes}}
                # one call, one journal entry (checkers count reads per call)
                journal("threads-list", pr=prs_seen[0],
                        **({"prs": prs_seen} if len(prs_seen) > 1 else {}))
                jq_project({"data": {"repository": repo}},
                           flag_val(argv, "--jq", "-q"))   # codex, PR #238: --jq honoured
                return
            if "resolveReviewThread" in q:
                tid = fields.get("t") or fields.get("threadId")
                for pr in st.get("prs", {}).values():
                    for t in pr.get("threads", []):
                        if t.get("id") == tid:
                            t["isResolved"] = True
                            journal("thread-resolve", write=True, thread=tid)
                            save(st)
                            jq_project({"data": {"resolveReviewThread":
                                        {"thread": {"isResolved": True}}}},
                                       flag_val(argv, "--jq", "-q"))
                            return
                unknown("resolve: thread %s not in fixture" % tid)
            unknown("graphql query not routed")

        m = re.match(r"repos/[^/]+/[^/]+/pulls/(\d+)/reviews$", target)
        if m:
            pr = st.get("prs", {}).get(m.group(1))
            if pr is None:
                unknown("reviews: pr %s not in fixture" % m.group(1))
            journal("reviews-list", pr=m.group(1))
            rows = [{"id": r.get("id"), "state": r.get("state"),
                     "body": r.get("body", ""),
                     "author": r.get("author", ""),
                     "submitted_at": r.get("submitted_at", "")}
                    for r in pr.get("reviews", [])]
            if flag_val(argv, "--jq"):
                for r in rows:
                    out(r)
            else:
                out([{"id": r["id"], "state": r["state"], "body": r["body"],
                      "user": {"login": r["author"]},
                      "submitted_at": r["submitted_at"]} for r in rows])
            return

        m = re.match(r"repos/[^/]+/[^/]+/issues/(\d+)/comments$", target)
        if m and method == "POST":   # #237: fields imply POST, as in gh
            # POST to the issues comments endpoint = top-level comment write
            # (works for PRs too — they are issues).
            n = m.group(1)
            fields = api_fields(argv)
            cid = next_id(st)
            tgt = st.get("prs", {}).get(n) or st.get("issues", {}).get(n)
            if tgt is None:
                unknown("comments POST: %s not in fixture" % n)
            key = "created_at" if n in st.get("prs", {}) else "createdAt"
            tgt.setdefault("comments", []).append(
                {"id": cid, "author": st.get("agent_login", "paul"),
                 "body": fields.get("body", ""), key: "2026-08-24T12:00:00Z"})
            journal("pr-comment" if n in st.get("prs", {}) else "issue-comment",
                    write=True, pr=n, body=fields.get("body", ""), via="api")
            save(st)
            jq_project({"id": cid, "body": fields.get("body", ""),
                        "user": {"login": st.get("agent_login", "paul")},
                        "html_url": web(st) + "/%s/%s#issuecomment-%d"
                                    % ("pull" if n in st.get("prs", {}) else "issues", n, cid)},
                       flag_val(argv, "--jq", "-q"))   # codex, PR #238: --jq honoured
            return

        # ---- gh api repos/o/r/issues/<n>/timeline — the issue's events, for
        # patrol's gate-label audit (#144): who applied each label. A fixture
        # states `timeline` explicitly when the actor matters (`event`,
        # `label`, `actor`, `type`, `created_at` per entry); otherwise one
        # `labeled` event per worn label is synthesized, by the issue's
        # author (`type` User), so every earlier fixture reads as it did.
        # GET only; `--paginate` is accepted; an absent issue stays UNKNOWN.
        m_tl = re.match(r"/?repos/[^/]+/[^/]+/issues/(\d+)/timeline$", target)
        if m_tl and method == "GET":
            n = m_tl.group(1)
            iss = st.get("issues", {}).get(n)
            if iss is None:
                unknown("timeline: issue %s not in fixture" % n)
            journal("label-events", issue=n, explicit="timeline" in iss)
            if "timeline" in iss:
                events = [{"event": e.get("event", "labeled"),
                           "actor": {"login": e.get("actor", ""),
                                     "type": e.get("type", "User")},
                           "label": {"name": e.get("label", "")},
                           "created_at": e.get("created_at", "")}
                          for e in iss["timeline"]]
            else:
                events = [{"event": "labeled",
                           "actor": {"login": iss.get("author", ""), "type": "User"},
                           "label": {"name": lab},
                           "created_at": iss.get("createdAt", "2026-08-01T00:00:00Z")}
                          for lab in iss.get("labels", [])]
            jq_project(events, flag_val(argv, "--jq", "-q"))
            return

        m = re.match(r"repos/[^/]+/[^/]+/issues/(\d+)/comments$", target)
        if m:
            n = m.group(1)
            src = st.get("prs", {}).get(n) or st.get("issues", {}).get(n)
            if src is None:
                unknown("comments: %s not in fixture" % n)
            journal("cr-comments-list", target=n)
            # `user` is REST's shape: `type` `Bot` and the `[bot]` suffix are
            # what ISSUE-COMMENTS-LIST and guard-gate rule I read (#174);
            # `author`/`type` stand in for the adapters' --jq projections.
            rows = [{"id": c.get("id"), "body": expand_shas(c.get("body", "")),
                     "author": c.get("author", ""),
                     "type": c.get("author_type", "User"),
                     "user": {"login": c.get("author", ""),
                              "type": c.get("author_type", "User")},
                     "created_at": c.get("created_at", c.get("createdAt", "")),
                     "html_url": web(st) + "/pull/%s#issuecomment-%s"
                                 % (n, c.get("id"))}
                    for c in src.get("comments", [])]
            if flag_val(argv, "--jq"):
                for r in rows:
                    out(r)
            else:
                out(rows)
            return

        # GET a PR's review comments (REST, flattened threads) — read-only
        # (F2 run-1 went invalid on `gh api repos/o/r/pulls/101/comments
        # --jq …`; same read-route class). `--jq` prints one row per line.
        m = re.match(r"repos/[^/]+/[^/]+/pulls/(\d+)/comments$", target)
        if m and method == "GET":
            n = m.group(1)
            if n not in st.get("prs", {}):
                unknown("review-comments: pr %s not in fixture" % n)
            journal("review-comments-list", pr=n)
            rows = []
            for t in st["prs"][n].get("threads", []):
                root = (t.get("comments") or [{}])[0].get("databaseId")
                for c in t.get("comments", []):
                    cid = c.get("databaseId")
                    rows.append({"id": cid, "body": c.get("body", ""),
                                 "user": {"login": c.get("author", "")},
                                 "path": t.get("path"), "line": t.get("line"),
                                 "created_at": c.get("createdAt", ""),
                                 **({"in_reply_to_id": root} if cid != root else {}),
                                 "html_url": web(st) + "/pull/%s"
                                             "#discussion_r%s" % (n, cid)})
            jq_project(rows, flag_val(argv, "--jq", "-q"))
            return

        m = re.match(r"repos/[^/]+/[^/]+/pulls/(\d+)/comments$", target)
        if m and method == "POST":   # #237: fields imply POST, as in gh
            n = m.group(1)
            if n not in st.get("prs", {}):
                unknown("thread-post: pr %s not in fixture" % n)
            fields = api_fields(argv)
            cid = next_id(st)
            st["prs"][n].setdefault("threads", []).append(
                {"id": "T%d" % cid, "isResolved": False,
                 "path": fields.get("path"), "line": fields.get("line"),
                 "comments": [{"databaseId": cid,
                               "author": st.get("agent_login", "paul"),
                               "body": fields.get("body", ""),
                               "createdAt": "2026-08-24T12:00:00Z"}]})
            journal("thread-post-inline", write=True, pr=n,
                    body=fields.get("body", ""), path=fields.get("path"))
            save(st)
            jq_project({"id": cid, "body": fields.get("body", ""),
                        "path": fields.get("path"), "line": fields.get("line"),
                        "user": {"login": st.get("agent_login", "paul")},
                        "html_url": web(st) + "/pull/%s#discussion_r%d" % (n, cid)},
                       flag_val(argv, "--jq", "-q"))   # codex, PR #238: --jq honoured
            return

        m = re.match(r"repos/[^/]+/[^/]+/pulls/(\d+)/comments/(\d+)/replies$",
                     target)
        if m:
            n, base = m.group(1), int(m.group(2))
            fields = api_fields(argv)
            for t in st.get("prs", {}).get(n, {}).get("threads", []):
                if any(c.get("databaseId") == base for c in t.get("comments", [])):
                    cid = next_id(st)
                    t["comments"].append(
                        {"databaseId": cid,
                         "author": st.get("agent_login", "paul"),
                         "body": fields.get("body", ""),
                         "createdAt": "2026-08-24T12:00:00Z"})
                    journal("thread-reply", write=True, pr=n, base=base,
                            body=fields.get("body", ""))
                    save(st)
                    jq_project({"id": cid, "body": fields.get("body", ""),
                                "in_reply_to_id": base,
                                "user": {"login": st.get("agent_login", "paul")},
                                "html_url": web(st) + "/pull/%s#discussion_r%d"
                                            % (n, cid)},
                               flag_val(argv, "--jq", "-q"))
                    return
            unknown("reply: comment %d not in fixture" % base)

        m = re.match(r"repos/[^/]+/[^/]+/issues/comments/(\d+)$", target)
        if m and method == "PATCH":   # #237: -X or --method, as in gh
            cid = int(m.group(1))
            fields = api_fields(argv)
            for coll in (st.get("issues", {}), st.get("prs", {})):
                for item in coll.values():
                    for c in item.get("comments", []):
                        if c.get("id") == cid:
                            c["body"] = fields.get("body", c.get("body"))
                            journal("comment-edit", write=True, comment=cid,
                                    body=fields.get("body", ""))
                            save(st)
                            jq_project({"id": cid, "body": c["body"]},
                                       flag_val(argv, "--jq", "-q"))
                            return
            unknown("comment-edit: %d not in fixture" % cid)

        # GET one comment by id — read-only (F5 run-2 went invalid on
        # `gh api repos/x/y/issues/comments/1001 --jq .body`; same read-
        # route class as PR #3/#5). `--jq .field` projects that field the
        # way gh prints it (strings raw); anything else prints the object.
        if m and method == "GET":
            cid = int(m.group(1))
            for kind, coll in (("pr", st.get("prs", {})),
                               ("issue", st.get("issues", {}))):
                for n, item in coll.items():
                    for c in item.get("comments", []):
                        if c.get("id") == cid:
                            journal("issue-comment-view", comment=cid)
                            obj = {"id": cid, "body": expand_shas(c.get("body", "")),
                                   "user": {"login": c.get("author", "")},
                                   "created_at": c.get("created_at",
                                                       c.get("createdAt", "")),
                                   "html_url": web(st) + "/%s/%s"
                                               "#issuecomment-%d"
                                               % ("pull" if kind == "pr"
                                                  else "issues", n, cid)}
                            jq_project(obj, flag_val(argv, "--jq", "-q"))
                            return
            unknown("comment-view: %d not in fixture" % cid)

        # #205 — ISSUE-BLOCKERS: an issue's forge-native blockers. Fixture:
        # `issues.<n>.blocked_by` (numbers; each blocker's state is its own
        # issue's) and `blocked_by_error` (an HTTP status the lookup answers
        # instead — an older GHES, a token without the scope). Patrol only
        # reads relationships: a write here is UNKNOWN, never performed.
        m = re.match(r"repos/[^/]+/[^/]+/issues/(\d+)/dependencies/blocked_by$", target)
        if m:
            n = m.group(1)
            if method != "GET":
                unknown("dependency write (%s): patrol never writes relationships" % method)
            iss = st.get("issues", {}).get(n)
            if iss is None:
                unknown("issue-blocked-by: %s not in fixture" % n)
            if iss.get("blocked_by_error"):
                code = int(iss["blocked_by_error"])
                http_error(code, {403: "Resource not accessible by integration",
                                  404: "Not Found"}.get(code, "Error"), target=target[:120])
            rows = []
            for b in iss.get("blocked_by", []):
                bi = st.get("issues", {}).get(str(b))
                if bi is None:
                    unknown("issue-blocked-by: blocker %s not in fixture" % b)
                rows.append({"number": int(b), "title": bi.get("title", ""),
                             "state": bi.get("state", "open"),
                             "html_url": web(st) + "/issues/%s" % b,
                             "repository_url": "https://api.github.com/repos/%s" % repo_slug(st)})
            journal("issue-blocked-by", issue=n)
            jq_project(rows, flag_val(argv, "--jq", "-q"))
            return

        # GET one issue by number through REST — `gh issue view`'s twin
        # (D2 re-run: `gh api repos/o/r/issues/5 --jq '.title, .body'`).
        m = re.match(r"repos/[^/]+/[^/]+/issues/(\d+)$", target)
        if m and method == "GET":
            n = m.group(1)
            iss = st.get("issues", {}).get(n)
            if iss is None:
                unknown("issue %s not in fixture" % n)
            journal("issue-view", issue=n, via="api")
            shape = issue_shape(st, n, iss, None)
            jq_project({"number": int(n), "title": shape["title"], "body": shape["body"],
                        "state": iss.get("state", "open"),
                        "labels": shape["labels"], "assignees": shape["assignees"],
                        "user": {"login": iss.get("author", "")},
                        "created_at": shape["createdAt"],
                        "comments": len(shape["comments"]),
                        "html_url": web(st) + "/issues/%s" % n},
                       flag_val(argv, "--jq", "-q"))
            return

        # GET one REVIEW comment by id — sibling of issue-comment-view
        # (D2 re-run: `gh api repos/o/r/pulls/103/comments/9101 [--jq .body]`).
        m = re.match(r"repos/[^/]+/[^/]+/pulls/(\d+)/comments/(\d+)$", target)
        if m and method == "GET":
            n, cid = m.group(1), int(m.group(2))
            for t in st.get("prs", {}).get(n, {}).get("threads", []):
                root = (t.get("comments") or [{}])[0].get("databaseId")
                for c in t.get("comments", []):
                    if c.get("databaseId") == cid:
                        journal("review-comment-view", pr=n, comment=cid)
                        jq_project({"id": cid, "body": c.get("body", ""),
                                    "user": {"login": c.get("author", "")},
                                    "path": t.get("path"), "line": t.get("line"),
                                    "created_at": c.get("createdAt", ""),
                                    **({"in_reply_to_id": root} if cid != root else {}),
                                    "html_url": web(st) + "/pull/%s#discussion_r%s" % (n, cid)},
                                   flag_val(argv, "--jq", "-q"))
                        return
            unknown("review-comment-view: pr %s comment %d not in fixture" % (n, cid))

        # GET a PR's changed files — read-only, from the sandbox's own
        # base...head diff (the pr diff route's method; #219: D13@B).
        m = re.match(r"repos/[^/]+/[^/]+/pulls/(\d+)/files$", target)
        if m and method == "GET":
            n = m.group(1)
            pr = st.get("prs", {}).get(n)
            if pr is None:
                unknown("pr-files: pr %s not in fixture" % n)
            try:
                rows = pr_files(pr.get("baseRefName", ""), pr.get("headRefName", ""))
            except (RuntimeError, OSError, subprocess.TimeoutExpired) as e:
                unknown("pr-files: git diff failed: %s" % e)
            journal("pr-files", pr=n)
            jq_project(rows, flag_val(argv, "--jq", "-q"))
            return

        # #237 — one review comment by id, the REST shape without the PR
        # number (`/pulls/comments/<id>`): read, edit, delete. The deletes are
        # routed, not refused — gh performs them; the journal shows the write.
        m = re.match(r"repos/[^/]+/[^/]+/pulls/comments/(\d+)$", target)
        if m:
            cid = int(m.group(1))
            for n, pr in st.get("prs", {}).items():
                for t in pr.get("threads", []):
                    for c in t.get("comments", []):
                        if c.get("databaseId") != cid:
                            continue
                        if method == "GET":
                            journal("review-comment-view", pr=n, comment=cid)
                            jq_project({"id": cid, "body": c.get("body", ""),
                                        "user": {"login": c.get("author", "")},
                                        "path": t.get("path"), "line": t.get("line"),
                                        "created_at": c.get("createdAt", ""),
                                        "html_url": web(st) + "/pull/%s"
                                                    "#discussion_r%s" % (n, cid)},
                                       flag_val(argv, "--jq", "-q"))
                            return
                        if method == "PATCH":
                            c["body"] = api_fields(argv).get("body", c.get("body", ""))
                            journal("review-comment-edit", write=True, pr=n, comment=cid,
                                    body=c["body"])
                            save(st)
                            jq_project({"id": cid, "body": c["body"], "path": t.get("path"),
                                        "line": t.get("line")},
                                       flag_val(argv, "--jq", "-q"))
                            return
                        if method == "DELETE":
                            t["comments"].remove(c)
                            if not t["comments"]:
                                pr["threads"].remove(t)
                            journal("review-comment-delete", write=True, pr=n, comment=cid)
                            save(st)
                            return
            unknown("review-comment: %d not in fixture" % cid)

        # #237 — delete a top-level issue/CR comment.
        m = re.match(r"repos/[^/]+/[^/]+/issues/comments/(\d+)$", target)
        if m and method == "DELETE":
            cid = int(m.group(1))
            for coll in (st.get("issues", {}), st.get("prs", {})):
                for item in coll.values():
                    for c in item.get("comments", []):
                        if c.get("id") == cid:
                            item["comments"].remove(c)
                            journal("comment-delete", write=True, comment=cid)
                            save(st)
                            return
            unknown("comment-delete: %d not in fixture" % cid)

        # #237 — an issue's (or PR's) labels through REST, `gh issue view
        # --json labels`'s twin.
        m = re.match(r"repos/[^/]+/[^/]+/issues/(\d+)/labels$", target)
        if m and method == "PATCH":   # GitHub has GET/POST/PUT/DELETE here, no PATCH
            http_error(404, "Not Found", target=target[:120])
        if m and method == "GET":
            n = m.group(1)
            item = st.get("issues", {}).get(n) or st.get("prs", {}).get(n)
            if item is None:
                unknown("issue-labels: %s not in fixture" % n)
            journal("issue-labels", issue=n)
            jq_project([{"name": lb} for lb in item.get("labels", [])],
                       flag_val(argv, "--jq", "-q"))
            return

        unknown("api target not routed: %s" % target)

    # ---- gh label list — read-only; a roz-gate fixture repo has the
    # plugin's label scheme installed (state may override via "labels")
    if argv[:2] == ["label", "list"]:
        journal("label-list")
        names = repo_labels(st)
        if flag_val(argv, "--jq"):
            for nm in names:
                print(nm)
        else:
            out([{"name": nm} for nm in names])
        return

    # ---- label create (init only; accept and journal)
    if argv[:2] == ["label", "create"]:
        journal("label-create", write=True, label=argv[2] if len(argv) > 2 else "")
        return

    unknown("no matching route")


main()
flush_journal()
