#!/usr/bin/env python3
"""roz-branch — the executable form of `references/branch-names.md` (#135).

    roz-branch validate [--json]
    roz-branch expand --kind spec|feat|qa|fast --n N [--type T] [--user U] [--seq S] [--json]
    roz-branch snapshot [--remote origin] [--json]            # one `git ls-remote --heads`
    roz-branch match --snapshot FILE --issues 5,6,8 [--types 5=fix,8=feat] [--tracks 5=spec]
                     [--json]
    roz-branch lookup --issues 5,6,8 [--types …] [--tracks …] [--remote origin] [--json]

Facts, read-only (#239): `expand` renders one name from explicit inputs and
never computes `{seq}`; `snapshot` is the only call that touches the
network; `match` is a pure function of a snapshot file; `lookup` is
snapshot + match in one call. No branch is created, deleted, checked out or
moved here. The template and `branch_user` come from bin/roz-config's local
file — this toplevel's, else the main checkout's.

Exit 0 with the JSON on stdout; 2 with a typed failure (INVALID_TEMPLATE ·
MISSING_REQUIRED_VALUE · INVALID_SEQUENCE · BAD_ARGUMENT) on stderr and, with
--json, as {"error": {"code", "why"}} on stdout.
"""

import json
import os
import subprocess
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "hooks"))
from branch_names import (  # noqa: E402
    BranchNameError,
    collect_remote_heads,
    effective,
    expand,
    local_key,
    match_issue,
    validate,
)
from config_block import main_checkout  # noqa: E402

USAGE = __doc__.split("\n\n")[1]


def fail(code, why, as_json):
    if as_json:
        print(json.dumps({"error": {"code": code, "why": why}}))
    sys.stderr.write("roz-branch: %s — %s\n" % (code, why))
    return 2


def git(*args):
    try:
        out = subprocess.run(["git", *args], capture_output=True, text=True, timeout=5)
    except (OSError, subprocess.TimeoutExpired):
        return None
    return out.stdout.strip() if out.returncode == 0 else None


def nearest_dotgit(start):
    """The nearest ancestor holding `.git` — the toplevel when git itself is
    not on PATH (`match` is pure and must not need it)."""
    d = os.path.abspath(start)
    while True:
        if os.path.exists(os.path.join(d, ".git")):
            return d
        parent = os.path.dirname(d)
        if parent == d:
            return None
        d = parent


def tops():
    top = git("rev-parse", "--show-toplevel") or nearest_dotgit(os.getcwd())
    return [top, main_checkout()]


def config():
    t = tops()
    return {"branch_template": effective(local_key(t, "branch_template")),
            "branch_user": local_key(t, "branch_user")}


def parse_map(s):
    """'5=fix,8=feat' → {'5': 'fix', '8': 'feat'}."""
    out = {}
    for part in (s or "").split(","):
        if not part.strip():
            continue
        if "=" not in part:
            raise ValueError(part)
        k, v = part.split("=", 1)
        out[k.strip()] = v.strip()
    return out


def opts(argv):
    """Flags → dict; the first bare word is the command."""
    cmd, o, i = None, {"json": False}, 0
    while i < len(argv):
        a = argv[i]
        if a == "--json":
            o["json"] = True
        elif a.startswith("--"):
            if i + 1 >= len(argv) or argv[i + 1].startswith("--"):
                raise ValueError("%s needs a value" % a)
            o[a[2:]] = argv[i + 1]
            i += 1
        elif cmd is None:
            cmd = a
        else:
            raise ValueError("unexpected argument %r" % a)
        i += 1
    return cmd, o


def cmd_validate(o, cfg):
    why = validate(cfg["branch_template"])
    out = {"branch_template": cfg["branch_template"], "valid": why is None, "why": why,
           "branch_user": cfg["branch_user"]}
    if o["json"]:
        print(json.dumps(out))
    else:
        print("%s %s" % (cfg["branch_template"], "valid" if why is None else "INVALID — " + why))
    return 0 if why is None else 2


def cmd_expand(o, cfg):
    for k in ("kind", "n"):
        if k not in o:
            return fail("BAD_ARGUMENT", "--%s is required" % k, o["json"])
    try:
        name = expand(cfg["branch_template"], kind=o["kind"], n=o["n"], type=o.get("type"),
                      user=o.get("user") or cfg["branch_user"], seq=o.get("seq"))
    except BranchNameError as e:
        return fail(e.code, e.why, o["json"])
    print(json.dumps({"branch": name, "kind": o["kind"], "n": o["n"],
                      "branch_template": cfg["branch_template"]}) if o["json"] else name)
    return 0


def do_match(snapshot, o, cfg):
    if "issues" not in o:
        return None, fail("BAD_ARGUMENT", "--issues is required", o["json"])
    try:
        types, tracks = parse_map(o.get("types")), parse_map(o.get("tracks"))
    except ValueError as e:
        return None, fail("BAD_ARGUMENT", "--types / --tracks take k=v pairs (%s)" % e, o["json"])
    why = validate(cfg["branch_template"])
    if why:
        return None, fail("INVALID_TEMPLATE", why, o["json"])
    issues = {}
    for n in [x.strip() for x in o["issues"].split(",") if x.strip()]:
        if not n.isdigit():
            return None, fail("BAD_ARGUMENT", "issue %r is not a number" % n, o["json"])
        issues[n] = match_issue(snapshot, cfg["branch_template"], n, track=tracks.get(n),
                                type=types.get(n))
    meta = {k: v for k, v in snapshot.items() if k != "heads"}
    return {"snapshot": meta, "branch_template": cfg["branch_template"], "issues": issues}, 0


def cmd_snapshot(o, cfg):
    snap = collect_remote_heads(o.get("remote", "origin"))
    print(json.dumps(snap, indent=1) if o["json"] else
          "%s %s %s" % (snap["remote"], snap["status"], snap.get("reason") or "%d heads" % len(snap["heads"])))
    return 0 if snap["status"] == "observed" else 2


def cmd_match(o, cfg):
    if "snapshot" not in o:
        return fail("BAD_ARGUMENT", "--snapshot FILE is required", o["json"])
    try:
        with open(o["snapshot"], encoding="utf-8") as f:
            snap = json.load(f)
    except (OSError, ValueError) as e:
        return fail("BAD_ARGUMENT", "cannot read the snapshot: %s" % e, o["json"])
    if not isinstance(snap, dict) or "status" not in snap:
        return fail("BAD_ARGUMENT", "the snapshot is not roz-branch's", o["json"])
    out, rc = do_match(snap, o, cfg)
    if out is not None:
        print(json.dumps(out, indent=1))
    return rc if rc else (0 if snap.get("status") == "observed" else 2)


def cmd_lookup(o, cfg):
    snap = collect_remote_heads(o.get("remote", "origin"))
    out, rc = do_match(snap, o, cfg)
    if out is not None:
        print(json.dumps(out, indent=1))
    return rc if rc else (0 if snap["status"] == "observed" else 2)


def main(argv):
    try:
        cmd, o = opts(argv)
    except ValueError as e:
        return fail("BAD_ARGUMENT", str(e), "--json" in argv)
    if cmd in (None, "-h", "--help", "help"):
        print(USAGE)
        return 0
    fn = {"validate": cmd_validate, "expand": cmd_expand, "snapshot": cmd_snapshot,
          "match": cmd_match, "lookup": cmd_lookup}.get(cmd)
    if fn is None:
        return fail("BAD_ARGUMENT", "unknown command %r\n%s" % (cmd, USAGE), o["json"])
    return fn(o, config())


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
